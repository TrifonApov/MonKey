@page
@model MonKey.Web.Areas.Identity.Pages.Account.Manage.IndexModel
@{
    ViewData["Title"] = "Account settings";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="mb-4">
                <p class="text-uppercase small fw-bold text-muted mb-2">Your account</p>
                <h1 class="h3 mb-2">Account settings</h1>
                <p class="text-muted mb-0">Manage your profile and sign-in details.</p>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">
                    @if (Model.StatusMessage is not null)
                    {
                        <div class="alert alert-success" role="status">@Model.StatusMessage</div>
                    }

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label"></label>
                            <input asp-for="Input.Email" class="form-control" readonly />
                            <div class="form-text">Email address changes require a confirmation flow.</div>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Input.Birthdate" class="form-label"></label>
                            <input asp-for="Input.Birthdate" class="form-control" autocomplete="bday" />
                            <span asp-validation-for="Input.Birthdate" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary">Save profile</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
