<div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
        <div class="modal-header">
            <div>
                <p class="section-kicker mb-1">NEW ACCOUNT</p>
                <h2 class="modal-title fs-5" id="account-create-title">Create an account</h2>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form action="" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="alert alert-danger d-none" role="alert" data-form-error></div>
                <div class="mb-3">
                    <label class="form-label" for="account-name">Account name</label>
                    <input class="form-control" id="account-name" name="Name" type="text" required autocomplete="off" />
                    <div class="invalid-feedback" data-validation-for="Name"></div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="account-description">Description <span class="text-muted">(optional)</span></label>
                    <textarea class="form-control" id="account-description" name="Description" rows="3" ></textarea>
                    <div class="invalid-feedback" data-validation-for="Description"></div>
                </div>
                <div class="row g-3">
                    <div class="col-sm-6 mb-3">
                        <label class="form-label" for="account-currency">Currency</label>
                        <select class="form-select" id="account-currency" name="CurrencyId" required>
                            <option value="">Select currency</option>
                        </select>
                        <div class="invalid-feedback" data-validation-for="CurrencyId"></div>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label class="form-label" for="account-balance">Opening balance</label>
                        <input class="form-control" id="account-balance" name="Balance" type="number" step="0.01" required value="0" />
                        <div class="invalid-feedback" data-validation-for="Balance"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" data-submit-account>Create account</button>
            </div>
        </form>
    </div>
</div>
