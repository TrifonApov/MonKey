@using Microsoft.AspNetCore.Identity
@using MonKey.Data.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav account-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link account-greeting" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Hello, @User.Identity?.Name</a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link account-link">Sign out</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link account-link" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
    </li>
    <li class="nav-item">
        <a class="nav-link account-cta" asp-area="Identity" asp-page="/Account/Register">Register <span aria-hidden="true">↗</span></a>
    </li>
}
</ul>
